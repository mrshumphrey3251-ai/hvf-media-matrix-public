# HVF Media Matrix - Enterprise Git Ignore Policy

# 1. Environment Variables & Secrets (CRITICAL)
.env
.env.*
*.pem
*.key
secrets.json

# 2. Logs & Audit Trails (CRITICAL)
hvf_secure_logs/
*.log

# 3. Python Compiled Caches
__pycache__/
*.py[cod]
*$py.class
*.so

# 4. Virtual Environments
venv/
env/
.venv/

# 5. IDE & OS Environment Files
.vscode/
.idea/
.DS_Store
Thumbs.db
