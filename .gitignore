# HVF Media Matrix - Enterprise Git Ignore Policy
# DFARS 252.227-7018 Compliant Configuration

# 1. Environment Variables & Secrets (CRITICAL)
.env
.env.*
*.pem
*.key
secrets.json

# 2. Logs & Audit Trails (CRITICAL)
hvf_secure_logs/
*.log

# 3. Python Compiled Caches
__pycache__/
*.py[cod]
*$py.class
*.so

# 4. Virtual Environments
venv/
env/
.venv/

# 5. IDE & OS Environment Files
.vscode/
.idea/
.DS_Store
Thumbs.db

# 6. Local Bare-Metal Neural Weights (Air-Gapped)
sovereign_ir_model/
sovereign_model/

# 7. Local Operational Databases & Runtime Caches
chroma_db/
_chroma_db_legacy_backup/
*.db
*.db-journal
*.sqlite3
*.sqlite3-journal
*.wal
*.shm
cinematic_vault/database/*.db

# 8. Media & Audio Caches
*.mp3
*.wav
